# Copy to .env.local and fill in values.
# For production (Vercel): add these in Project → Settings → Environment Variables.

# Google Analytics 4 Measurement ID (this project: Osama Moussa)
NEXT_PUBLIC_GA_ID=G-8R8NW8F24B

# Vercel Blob (video uploads)
# On Vercel: connect the Blob store and Upgrade to OIDC (preferred).
# That sets BLOB_STORE_ID; VERCEL_OIDC_TOKEN is injected automatically.
# Local: run `vercel link` then `vercel env pull`, or use the legacy token below.
BLOB_STORE_ID=
# Legacy / off-Vercel only — omit on Vercel after OIDC upgrade
BLOB_READ_WRITE_TOKEN=
